{
  "cleanUrls": true,
  "redirects": [
    { "source": "/:path(.*)", "has": [{ "type": "host", "value": "www.thainguyen.fit" }], "destination": "https://thainguyen.fit/:path", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/(favicon.ico|favicon.svg|apple-touch-icon.png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
